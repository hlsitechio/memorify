# Frontend (Vite — baked at build)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
VITE_APP_URL=https://memorify.dev
VITE_MCP_URL=https://memorify.dev/mcp
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Backend / Edge (Netlify env only — never commit secrets)
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_FRONTEND_API_URL=https://clerk.memorify.dev
NEON_DATABASE_URL=postgresql://...
MEMORIFY_AGENT_TOKEN_SECRET=long-random-string
NEON_JWT_PRIVATE_KEY=base64-encoded-pkcs8-ed25519-private-key
NEON_JWT_PUBLIC_KEY=base64-encoded-raw-ed25519-public-key
GITHUB_OAUTH_CLIENT_ID=github-oauth-app-client-id
GITHUB_OAUTH_CLIENT_SECRET=github-oauth-app-client-secret
GITHUB_OAUTH_CALLBACK_URL=https://memorify.dev/api/oauth/github/callback
GITHUB_OAUTH_SCOPES=repo workflow read:user

# Stripe (add to Netlify env)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Remote MCP OAuth providers (repeat with provider id uppercased, e.g. NOTION, LINEARMCP, SENTRY)
MCP_OAUTH_NOTION_CLIENT_ID=oauth-client-id
MCP_OAUTH_NOTION_CLIENT_SECRET=oauth-client-secret-if-required
MCP_OAUTH_NOTION_AUTHORIZE_URL=https://provider.example.com/oauth/authorize
MCP_OAUTH_NOTION_TOKEN_URL=https://provider.example.com/oauth/token
MCP_OAUTH_NOTION_CALLBACK_URL=https://memorify.dev/api/mcp/oauth/callback
MCP_OAUTH_NOTION_RESOURCE=https://mcp.notion.com/mcp
MCP_OAUTH_NOTION_SCOPES=
NODE_VERSION=20
NPM_CONFIG_PRODUCTION=false
